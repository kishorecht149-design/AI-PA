# ==============================================================================
# AMAHAS Environment Configuration Template
# Autonomous Multimodal Holographic Assistant System
# ==============================================================================

# Database Configuration (Defaults to local SQLite if not specified)
# For local SQLite: "file:./dev.db"
# For managed PostgreSQL / Supabase: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DATABASE_URL="file:./dev.db"

# Application Session & Authentication Secrets
# Generate a strong 32+ character random string for production
AUTH_SECRET="development-secret-change-in-production-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# AI Gateway Configuration (OpenRouter - Primary Configurable Gateway)
# Free router: "openrouter/free"
# Explicit free variants e.g. "google/gemini-2.0-flash-exp:free" or "meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_API_KEY=""
DEFAULT_AI_MODEL="openrouter/free"

# Local AI Configuration (Ollama - Optional Local Inference)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3.2"

# Research Discovery Services
# OpenAlex provides polite pool access with an email
OPENALEX_MAILTO="student@amahas.internal"

# External Automation Engine (n8n - Optional External Connector)
N8N_BASE_URL=""
N8N_API_KEY=""

# Task Management Synchronization (Vikunja - Optional Connector)
VIKUNJA_BASE_URL=""
VIKUNJA_API_TOKEN=""

# GitHub Integration (Optional)
GITHUB_ACCESS_TOKEN=""

# Logging & Operational Environment
NODE_ENV="development"
PORT="3000"
