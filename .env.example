# ==============================================================================
# AMAHAS AI PA - PRODUCTION ENVIRONMENT VARIABLES (Vercel & Supabase)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard -> Project Settings -> Database -> Connection Strings

# Transaction Connection Pooler (Port 6543) - Used by Next.js Serverless runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Used by Prisma CLI for db push / migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# (For local offline development with SQLite, use: DATABASE_URL="file:./dev.db")

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-32-character-secret-string"

# Your production deployment URL (or http://localhost:3000 for local development)
NEXTAUTH_URL="https://your-project-name.vercel.app"

# ------------------------------------------------------------------------------
# 3. AI PROVIDERS & INTELLIGENCE
# ------------------------------------------------------------------------------
# Free keys available at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
DEFAULT_AI_MODEL="openrouter/free"

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="production"
